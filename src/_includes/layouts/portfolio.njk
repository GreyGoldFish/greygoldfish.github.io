{% extends layouts.base %}

{% block content %}
<div class="l-main py-12">
    <article>
        {% include partials.intro %}
        <div class="prose max-w-none">
            {{ content | safe }}
        </div>
        {% set listing = {
            collection: "project",
            reverse: true,
            type: "grid",
            columns: 3,
            headline: "Featured Projects",
            emptyText: "No projects available yet. Check back soon!"
        } %}
        {% include partials.listing %}
    </article>
</div>
{% endblock %}
