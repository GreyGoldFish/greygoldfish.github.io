{% extends layouts.base %}

{% block content %}
<div class="l-main py-16">
    {% include partials.intro %}

    <div class="l-contact-form__container">
        {% if 'success=true' in page.url %}
            <div id="form-success-message" class="l-contact-form__form-wrapper text-center">
                <h2 class="text-2xl font-bold text-heading mb-4">Thank You!</h2>
                <p>Your message has been sent successfully. I'll get back to you as soon as possible.</p>
                <a href="/" class="c-button mt-6">Back to Home</a>
            </div>
        {% else %}
            <div class="prose max-w-none text-center mb-8">
                {{ content | safe }}
            </div>
            
            <div id="contact-form" class="l-contact-form__form-wrapper">
                 {% include components.form %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
