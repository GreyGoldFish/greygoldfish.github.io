{% set introTitle = intro.title | default("") %}
{% set introSummary = intro.summary | default("") %}
{% set introEyebrow = intro.eyebrow | default("") %}

{% if introTitle or introSummary or introEyebrow %}
<header class="p-intro">
    <div class="p-intro__container">
        {% if introEyebrow %}
        <p class="p-intro__eyebrow">{{ introEyebrow | safe }}</p>
        {% endif %}
        {% if introTitle %}
        <h1 class="p-intro__title">{{ introTitle | safe }}</h1>
        {% endif %}
        {% if introSummary %}
        <p class="p-intro__summary">{{ introSummary | safe }}</p>
        {% endif %}
    </div>
</header>
{% endif %}

