{# Site header #}
{% set socials = socialData %}
<header class="p-banner" role="banner">
    <div class="p-banner__container">
		<a href="#main-content" class="p-banner__skip-link">
			{{ siteData.skipToContentText | default("Skip to main content") }}
		</a>

        {% include components.logo %}
        
        <div class="p-banner__nav-socials">
            <div class="hidden md:block">
                {% include components.navbar %}
            </div>

            <div class="hidden md:block">
                {% include components.socials %}
            </div>

            <button type="button" class="c-theme-toggle" data-toggle="theme" aria-pressed="false" aria-label="Toggle dark mode">
                <svg class="c-theme-toggle__icon c-theme-toggle__icon--sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.106a.75.75 0 010 1.06l-1.591 1.59a.75.75 0 11-1.06-1.06l1.59-1.59a.75.75 0 011.061 0zM21.75 12a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0v-2.25a.75.75 0 01.75-.75zM17.803 17.803a.75.75 0 01-1.06 0l-1.59-1.591a.75.75 0 111.06-1.06l1.59 1.59a.75.75 0 010 1.06zM12 21a.75.75 0 01-.75.75v2.25a.75.75 0 011.5 0v-2.25A.75.75 0 0112 21zM5.197 17.803a.75.75 0 010-1.06l1.59-1.591a.75.75 0 111.06 1.06l-1.59 1.59a.75.75 0 01-1.06 0zM1.5 12a.75.75 0 01.75-.75h2.25a.75.75 0 010 1.5H2.25A.75.75 0 011.5 12zM6.106 5.197a.75.75 0 011.06 0l1.59 1.591a.75.75 0 11-1.06 1.06l-1.59-1.59a.75.75 0 010-1.06z"></path></svg>
                <svg class="c-theme-toggle__icon c-theme-toggle__icon--moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-3.833 2.067-7.17 5.163-9.032a.75.75 0 01.818.162z" clip-rule="evenodd"></path></svg>
            </button>
            
            <div class="md:hidden">
                <button type="button" class="c-navbar__toggle" aria-label="Open main menu" aria-controls="mobile-menu" aria-expanded="false" data-toggle="navbar-menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="p-mobile-menu" aria-hidden="true">
        <div class="p-mobile-menu__container">
            <button type="button" class="p-mobile-menu__close-btn" aria-label="Close menu" data-toggle="navbar-menu">
                 <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div class="p-mobile-menu__nav">
                <ul class="p-mobile-menu__list">
                    {% set navPages = collections.all | eleventyNavigation %}
                    {% for entry in navPages %}
                    <li>
                        <a href="{{ entry.url }}" class="p-mobile-menu__link">
                            {{ entry.title }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="p-mobile-menu__socials">
                {% include components.socials %}
            </div>
        </div>
    </div>
</header>
