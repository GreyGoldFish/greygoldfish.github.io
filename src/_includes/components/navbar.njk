<nav aria-label="Primary Navigation">
  <div>
    <a href="/">{{ siteData.name }}</a>
    <button type="button" aria-label="Open main menu" aria-controls="navbar-menu" aria-expanded="false" onclick="this.nextElementSibling.classList.toggle('max-h-0');this.nextElementSibling.classList.toggle('max-h-96');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true')">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
    {% set navPages = collections.all | eleventyNavigation %}
    <div id="navbar-menu">
      <ul>
        {% for entry in navPages %}
        <li>
          <a href="{{ entry.url }}">
            {{ entry.title }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</nav>